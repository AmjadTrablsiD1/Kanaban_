# Your personal board — projects, tasks, notes. Stays on your machine only.
# kanban.py recreates it from defaults on first run, so it is safe to not commit.
board.json
board.json.tmp

# Your wallpaper and the safety copies an update leaves behind.
wallpaper.jpg
wallpaper.png
wallpaper.webp
wallpaper.gif
.update-backup/

# Python
__pycache__/
*.py[cod]

# macOS
.DS_Store
._*

# Kanaban Mind (mind/): your maps live in ~/.config/kanaban-mind, never in here.
# These are only made when someone develops or tests it inside this folder.
mind/.venv/
mind/node_modules/
mind/ui/node_modules/
mind/test-results/
mind/playwright-report/
mind/.e2e-data/
mind/tests/screenshots/*.png
!mind/tests/screenshots/baseline/*.png
mind/**/*.tsbuildinfo
maps/
workspace.json
settings.json
